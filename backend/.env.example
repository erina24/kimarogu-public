# backend(FastAPI)用の環境変数の見本
# コピーして .env を作り、自分の値に書きかえて使う(.env はコミットしない)
#   cp .env.example .env
# ユーザー名・パスワード・DB名は、リポジトリ直下の .env と同じにする
DATABASE_URL=postgresql+psycopg://sec8_user:your-password@localhost:5435/sec8_db
# Firebase のサービスアカウント鍵の場所(鍵のファイルは backend/secrets/ に置く。コミットしない)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
