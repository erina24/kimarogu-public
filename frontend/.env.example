# frontend（Next.js）の環境変数の見本
# このファイルをコピーして .env.local を作り、自分の値に書き換えて使う
#   cp .env.example .env.local
# ※ .env.local は .gitignore で GitHub に上がらないようにしている

# FastAPI（バックエンド）の場所。Next.js のサーバーからだけ使うので NEXT_PUBLIC_ は付けない
API_BASE_URL=http://127.0.0.1:8001

# Mastra（チャットボット）の場所。Next.js のサーバーからだけ使うので NEXT_PUBLIC_ は付けない
MASTRA_URL=http://localhost:4111
MASTRA_API_URL=http://localhost:4111

# Firebase（Google ログイン）の設定
# Firebase コンソール →「プロジェクトの設定」→「マイアプリ」のウェブアプリの値を入れる
# ブラウザで使うので NEXT_PUBLIC_ を付ける（ログイン画面を開くための公開用の値。秘密鍵ではない）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mastra RAG登録APIの認証用（mastra/.env と同じ値を設定）
RAG_INGEST_SECRET=
