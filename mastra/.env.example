# ===== Mastra 用の環境変数の見本 =====
# このファイルをコピーして .env を作り、自分の値に書きかえて使う(.env はコミットしない)
#   cp .env.example .env

# OpenRouter の API キー(チャットの会話と、文章を数字にする埋め込みで使う)
OPENROUTER_API_KEY=your-openrouter-api-key

# PostgreSQL への接続先(形:postgresql://ユーザー名:パスワード@場所:ポート番号/DB名)
POSTGRES_CONNECTION_STRING=postgresql://sec8_user:your-password@localhost:5435/sec8_db

# RAG登録APIの認証用シークレット
RAG_INGEST_SECRET=
